#!/bin/bash
# =============================================================================
# Common Functions - Shared utilities for all Rust server scripts
# =============================================================================

# -----------------------------------------------------------------------------
# Color codes for logging
# -----------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# -----------------------------------------------------------------------------
# Logging functions
# -----------------------------------------------------------------------------
log_info() {
    echo -e "${BLUE}[INFO]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $*"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $*"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $*"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $*"
}

# -----------------------------------------------------------------------------
# Path constants
# -----------------------------------------------------------------------------
# The in-image layout is fixed. TEST_ROOT is empty in every container and exists
# only so the unit tests can exercise these scripts outside one.
TEST_ROOT="${TEST_ROOT:-}"
STEAMCMD_PATH="${TEST_ROOT}/opt/steamcmd"
RUST_SERVER_PATH="${TEST_ROOT}/opt/rust/server"
CONFIG_PATH="${TEST_ROOT}/config"
SETTINGS_PATH="${CONFIG_PATH}/settings"
BACKUPS_PATH="${CONFIG_PATH}/backups"
OXIDE_PATH="${CONFIG_PATH}/oxide"
LOG_PATH="${TEST_ROOT}/var/log/rust"
PID_PATH="${TEST_ROOT}/var/run/rust"

RUST_SERVER_PID="${PID_PATH}/rust-server.pid"

# The account the server runs as (config/supervisord.conf sets user=rust), its
# home, and the home SteamCMD uses when it runs as root.
SERVER_USER="${SERVER_USER:-rust}"
SERVER_GROUP="${SERVER_GROUP:-rust}"
SERVER_HOME="${TEST_ROOT}/home/${SERVER_USER}"
STEAMCMD_HOME="${TEST_ROOT}/root"
RCON_PASSWORD_FILE="${CONFIG_PATH}/rcon_password"
RUST_APP_ID="258550"

# -----------------------------------------------------------------------------
# Server binary path
# -----------------------------------------------------------------------------
RUST_SERVER_BINARY="${RUST_SERVER_PATH}/RustDedicated"

# -----------------------------------------------------------------------------
# Environment helpers
# -----------------------------------------------------------------------------
get_server_port() {
    echo "${SERVER_PORT:-28015}"
}

get_rcon_port() {
    echo "${RCON_PORT:-28016}"
}

get_rcon_web_port() {
    echo "${RCON_WEB_PORT:-28017}"
}

get_query_port() {
    echo "${QUERY_PORT:-27015}"
}

get_server_name() {
    echo "${SERVER_NAME:-Rust Server}"
}

get_server_identity() {
    echo "${SERVER_IDENTITY:-rust_server}"
}

get_server_seed() {
    # Generate random seed if not set
    if [[ -z "${SERVER_SEED}" ]]; then
        echo "$((RANDOM * RANDOM))"
    else
        echo "${SERVER_SEED}"
    fi
}

get_server_worldsize() {
    echo "${SERVER_WORLDSIZE:-4000}"
}

get_max_players() {
    echo "${SERVER_MAXPLAYERS:-50}"
}

get_server_level() {
    echo "${SERVER_LEVEL:-Procedural Map}"
}

get_save_interval() {
    echo "${SERVER_SAVEINTERVAL:-600}"
}

is_rcon_enabled() {
    [[ "${RCON_ENABLED,,}" == "true" ]]
}

is_rcon_web_enabled() {
    [[ "${RCON_WEB,,}" == "true" ]]
}

is_update_on_start_enabled() {
    [[ "${UPDATE_ON_START,,}" == "true" ]]
}

is_oxide_enabled() {
    [[ "${ENABLE_OXIDE,,}" == "true" ]]
}

is_oxide_auto_update_enabled() {
    [[ "${OXIDE_AUTO_UPDATE,,}" == "true" ]]
}

is_backups_enabled() {
    [[ "${BACKUPS_ENABLED,,}" == "true" ]]
}

# -----------------------------------------------------------------------------
# RCON password helpers
# -----------------------------------------------------------------------------
# Known default passwords that must never protect a remote console
RCON_PASSWORD_DENYLIST=("changeme" "password" "your_secure_password" "admin" "rcon")

is_default_rcon_password() {
    local candidate="${1,,}"
    local denied

    if [[ -z "${candidate}" ]]; then
        return 0
    fi
    for denied in "${RCON_PASSWORD_DENYLIST[@]}"; do
        if [[ "${candidate}" == "${denied}" ]]; then
            return 0
        fi
    done
    return 1
}

# Decides the RCON password and stores it in the global RCON_PASSWORD.
# An empty or known-default password is replaced by a random one saved to
# ${RCON_PASSWORD_FILE}; the value itself is never logged.
# Note: this logs to stdout, so never call it via $(...) - read RCON_PASSWORD
resolve_rcon_password() {
    if ! is_rcon_enabled; then
        return 0
    fi

    # User-supplied password: use unchanged
    if ! is_default_rcon_password "${RCON_PASSWORD}"; then
        return 0
    fi

    # Reuse the password generated on a previous start
    local stored=""
    if [[ -r "${RCON_PASSWORD_FILE}" ]]; then
        stored=$(tr -d '\r\n' < "${RCON_PASSWORD_FILE}")
    fi
    if [[ ${#stored} -ge 24 ]]; then
        RCON_PASSWORD="${stored}"
        log_info "Using generated RCON password from ${RCON_PASSWORD_FILE}"
        return 0
    fi

    log_warn "RCON_PASSWORD is empty or a known default, generating a random one"

    # Alphanumeric only, so it is safe on the server command line
    local generated
    generated=$(head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)
    if [[ ${#generated} -lt 24 ]]; then
        log_error "Failed to generate an RCON password, disabling RCON"
        RCON_ENABLED=false
        return 1
    fi

    # Write with mode 600, owned by the server user
    if ! (umask 077 && echo "${generated}" > "${RCON_PASSWORD_FILE}"); then
        log_error "Failed to write ${RCON_PASSWORD_FILE}, disabling RCON"
        RCON_ENABLED=false
        return 1
    fi
    chmod 600 "${RCON_PASSWORD_FILE}"
    chown rust:rust "${RCON_PASSWORD_FILE}" 2>/dev/null || true

    RCON_PASSWORD="${generated}"
    log_success "Generated RCON password saved to ${RCON_PASSWORD_FILE}"
    log_info "Read it with: docker exec <container> cat ${RCON_PASSWORD_FILE}"
    return 0
}

# -----------------------------------------------------------------------------
# Process helpers
# -----------------------------------------------------------------------------
# True while a pid is a live process. A process that has exited but has not yet
# been reaped is still a valid pid and still answers kill -0, so a wait loop
# built on kill -0 alone can hang on a zombie forever.
process_alive() {
    local pid="$1"
    [[ -n "${pid}" ]] || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    local state
    state="$(awk '{print $3}' "/proc/${pid}/stat" 2>/dev/null)"
    [[ "${state}" != "Z" ]]
}

is_server_running() {
    if [[ -f "${RUST_SERVER_PID}" ]]; then
        local pid
        pid=$(cat "${RUST_SERVER_PID}")
        if kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
    fi
    # Also check by process name
    pgrep -f "RustDedicated" > /dev/null 2>&1
}

get_server_pid() {
    if [[ -f "${RUST_SERVER_PID}" ]]; then
        cat "${RUST_SERVER_PID}"
    else
        pgrep -f "RustDedicated" 2>/dev/null | head -1
    fi
}

# -----------------------------------------------------------------------------
# WebRCON
# -----------------------------------------------------------------------------
# RustDedicated does not save on SIGINT: it shuts EAC, RakNet and Steamworks down
# within a second and exits 0 with the world unwritten (run 35529257566). The only
# way to get a save on shutdown is to ask for one, and WebRCON is the channel the
# server listens on. Its stdin is not a console, so a piped command goes nowhere.
#
# The image has no WebSocket client and needs none. A client frame must be masked,
# but an all-zero mask key is legal and leaves the payload unchanged, so a frame
# is a two- or four-byte header, four zero bytes and the JSON, which bash can
# write to /dev/tcp directly.

# The password the running server was started with, without generating one.
# resolve_rcon_password would invent a fresh password if the file were missing,
# and a password the server never saw can only fail.
current_rcon_password() {
    if ! is_default_rcon_password "${RCON_PASSWORD}"; then
        echo "${RCON_PASSWORD}"
        return 0
    fi
    local stored=""
    [[ -r "${RCON_PASSWORD_FILE}" ]] && stored=$(tr -d '\r\n' < "${RCON_PASSWORD_FILE}")
    [[ ${#stored} -ge 24 ]] || return 1
    echo "${stored}"
}

# Opens an upgraded WebRCON connection and leaves its fd in RCON_FD.
rcon_open() {
    local password path status header
    RCON_FD=""
    is_rcon_enabled && is_rcon_web_enabled || return 1
    password="$(current_rcon_password)" || return 1
    # jq is in the image; @uri keeps a user-chosen password intact in the path.
    path="/$(jq -rn --arg p "${password}" '$p | @uri')"

    # The braces scope the 2>/dev/null to this one connect. On a bare exec it
    # would apply to the shell itself and silence the wrapper's stderr for good.
    { exec {RCON_FD}<>"/dev/tcp/127.0.0.1/$(get_rcon_port)"; } 2>/dev/null || { RCON_FD=""; return 1; }
    printf 'GET %s HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n' \
        "${path}" >&"${RCON_FD}"

    # A wrong password is refused at the upgrade, so 101 is also the auth check.
    if ! IFS= read -r -t 10 status <&"${RCON_FD}" || [[ "${status}" != *" 101 "* ]]; then
        rcon_close
        return 1
    fi
    while IFS= read -r -t 10 header <&"${RCON_FD}" && [[ -n "${header%$'\r'}" ]]; do :; done
}

# Closes the connection the way WebSocket expects: a masked, empty close frame,
# then whatever the server still has in flight is read and discarded. Dropping
# the socket with its reply and broadcast log lines unread makes the kernel send
# a reset, and Fleck logs every reset as a SocketException stack trace (run
# 35642672267). Bounded, because the server broadcasts its console to every
# WebRCON client and may keep talking.
rcon_close() {
    [[ -n "${RCON_FD:-}" ]] || return 0
    printf '\x88\x80\x00\x00\x00\x00' 1>&"${RCON_FD}" 2>/dev/null
    local junk reads=0
    while [[ ${reads} -lt 20 ]] && IFS= read -r -t 1 -d '' junk <&"${RCON_FD}" 2>/dev/null; do
        reads=$((reads + 1))
    done
    exec {RCON_FD}>&-
    RCON_FD=""
}

# "Saved <n> ents" is what SaveRestore prints when it has written the world, for a
# requested save and a scheduled one alike. "Saving World" is not: it is printed
# once while the world is processed at startup, and server.save never prints it,
# so waiting for it timed out on a save that had completed in under a second.
SAVE_WRITTEN_PATTERN='Saved [0-9]+ ents'

# grep -c prints 0 and exits 1 on no match, and prints nothing on a missing file.
count_saves() {
    local n
    n="$(grep -cE "${SAVE_WRITTEN_PATTERN}" "$1" 2>/dev/null)"
    echo "${n:-0}"
}

# rcon_send <fd> <command> ; one masked text frame carrying a WebRcon request
rcon_send() {
    local fd="$1" payload len
    # -a escapes anything outside ASCII, so the length in characters is the
    # length in bytes, which is what the frame header has to carry.
    payload="$(jq -acn --arg m "$2" '{Identifier: 1001, Message: $m, Name: "WebRcon"}')"
    len=${#payload}
    if [[ ${len} -lt 126 ]]; then
        printf '%b' "\\x81\\x$(printf '%02x' $((0x80 | len)))" >&"${fd}"
    else
        printf '%b' "\\x81\\xfe\\x$(printf '%02x' $((len >> 8)))\\x$(printf '%02x' $((len & 0xff)))" >&"${fd}"
    fi
    printf '\x00\x00\x00\x00%s' "${payload}" >&"${fd}"
}

# Asks the server to save and waits until it says it has: a new "Saved <n> ents"
# line in the server log (see SAVE_WRITTEN_PATTERN). Returns 1 if the save could
# not be requested or was not confirmed within the timeout; the caller stops the
# server either way.
save_world() {
    local timeout="${1:-60}"
    local log="${LOG_PATH}/rust-server.log"
    local before elapsed=0

    before="$(count_saves "${log}")"
    if ! rcon_open; then
        log_warn "Could not reach WebRCON to request a save"
        return 1
    fi
    log_info "Requesting a world save over WebRCON"
    rcon_send "${RCON_FD}" "server.save"

    while [[ "$(count_saves "${log}")" -le "${before}" ]]; do
        if [[ ${elapsed} -ge ${timeout} ]]; then
            rcon_close
            log_warn "The server did not confirm a save within ${timeout}s"
            return 1
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    rcon_close
    log_success "World saved"
    return 0
}

# rcon_read_frame ; one frame from RCON_FD, payload on stdout. Returns 1 on a
# close frame, a timeout or a broken stream. Server frames are unmasked, and dd
# with iflag=fullblock reads exactly the bytes asked for: anything that read
# ahead would swallow the start of the next frame, which a socket cannot give back.
rcon_read_frame() {
    local header b0 b1 len
    header="$(timeout 10 dd bs=2 count=1 iflag=fullblock status=none <&"${RCON_FD}" | od -An -tu1)" || return 1
    read -r b0 b1 <<< "${header}"
    [[ -n "${b1:-}" ]] || return 1
    (( (b0 & 0x0F) == 8 )) && return 1
    len=$(( b1 & 0x7F ))
    if (( len == 126 )); then
        len=$(timeout 10 dd bs=2 count=1 iflag=fullblock status=none <&"${RCON_FD}" | od -An -tu1 | awk '{print $1 * 256 + $2}')
    elif (( len == 127 )); then
        len=$(timeout 10 dd bs=8 count=1 iflag=fullblock status=none <&"${RCON_FD}" | od -An -tu1 | awk '{n = 0; for (i = 1; i <= NF; i++) n = n * 256 + $i; print n}')
    fi
    [[ "${len}" =~ ^[0-9]+$ ]] || return 1
    (( len == 0 )) && return 0
    timeout 10 dd bs="${len}" count=1 iflag=fullblock status=none <&"${RCON_FD}"
}

# rcon_command <command> [timeout] ; runs one console command over WebRCON and
# prints the server's reply. The server also broadcasts its console to every
# WebRCON client, so frames are read until the one answering our Identifier.
rcon_command() {
    local command="$1" timeout="${2:-15}" deadline frame reply
    rcon_open || return 1
    rcon_send "${RCON_FD}" "${command}"
    deadline=$(( SECONDS + timeout ))
    while (( SECONDS < deadline )); do
        frame="$(rcon_read_frame)" || break
        reply="$(jq -r 'select(.Identifier == 1001) | .Message' <<< "${frame}" 2>/dev/null)"
        if [[ -n "${reply}" ]]; then
            rcon_close
            printf '%s\n' "${reply}"
            return 0
        fi
    done
    rcon_close
    return 1
}

# The number of players connected, as the server itself reports it through
# `serverinfo`. This was a placeholder that always said 0, so the idle guard
# never held an update and "skip backups while players are on" never skipped.
# A count that cannot be read prints nothing and returns 1: unknown is not zero
# (standard 2.8), and each caller decides what unknown means for it.
get_player_count() {
    local info count
    info="$(rcon_command serverinfo)" || return 1
    count="$(jq -r '.Players // empty' <<< "${info}" 2>/dev/null)"
    [[ "${count}" =~ ^[0-9]+$ ]] || return 1
    echo "${count}"
}

# -----------------------------------------------------------------------------
# Permission helpers
# -----------------------------------------------------------------------------
setup_permissions() {
    local puid="${PUID:-1000}"
    local pgid="${PGID:-1000}"
    local umask_val="${UMASK:-022}"

    log_info "Setting up permissions (UID=${puid}, GID=${pgid}, UMASK=${umask_val})"

    # Set umask
    umask "${umask_val}"

    # Update rust user/group IDs if different from default
    if [[ "${puid}" != "1000" ]]; then
        usermod -o -u "${puid}" rust 2>/dev/null || true
    fi
    if [[ "${pgid}" != "1000" ]]; then
        groupmod -o -g "${pgid}" rust 2>/dev/null || true
    fi

    # Fix ownership of key directories
    chown -R rust:rust /opt/rust 2>/dev/null || true
    chown -R rust:rust /config 2>/dev/null || true
    chown -R rust:rust /var/log/rust 2>/dev/null || true
    chown -R rust:rust /var/run/rust 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# Timezone setup
# -----------------------------------------------------------------------------
setup_timezone() {
    local tz="${TZ:-UTC}"

    if [[ -f "/usr/share/zoneinfo/${tz}" ]]; then
        ln -snf "/usr/share/zoneinfo/${tz}" /etc/localtime
        echo "${tz}" > /etc/timezone
        log_info "Timezone set to ${tz}"
    else
        log_warn "Invalid timezone '${tz}', using UTC"
        ln -snf /usr/share/zoneinfo/UTC /etc/localtime
        echo "UTC" > /etc/timezone
    fi
}

# -----------------------------------------------------------------------------
# SteamCMD helpers
# -----------------------------------------------------------------------------
run_steamcmd() {
    local args="$*"
    "${STEAMCMD_PATH}/steamcmd.sh" ${args}
}

get_installed_build_id() {
    local manifest="${RUST_SERVER_PATH}/steamapps/appmanifest_${RUST_APP_ID}.acf"
    if [[ -f "${manifest}" ]]; then
        grep -oP '"buildid"\s*"\K[^"]+' "${manifest}" 2>/dev/null || echo "unknown"
    else
        echo "unknown"
    fi
}

# -----------------------------------------------------------------------------
# Oxide helpers
# -----------------------------------------------------------------------------
is_oxide_installed() {
    [[ -f "${RUST_SERVER_PATH}/RustDedicated_Data/Managed/Oxide.Core.dll" ]]
}

get_oxide_version() {
    if ! is_oxide_installed; then
        echo "not installed"
        return 0
    fi

    # Written by oxide-installer from the pinned OXIDE_VERSION.
    local marker="${RUST_SERVER_PATH}/oxide/.oxide_version"
    if [[ -s "${marker}" ]]; then
        tr -d '\r\n' < "${marker}"
        return 0
    fi

    local version_file="${RUST_SERVER_PATH}/RustDedicated_Data/Managed/Oxide.Core.dll.version"
    if [[ -f "${version_file}" ]]; then
        cat "${version_file}"
    else
        echo "installed"
    fi
}

# -----------------------------------------------------------------------------
# Server identity path helper
# -----------------------------------------------------------------------------
get_server_data_path() {
    local identity
    identity=$(get_server_identity)
    echo "${RUST_SERVER_PATH}/server/${identity}"
}

get_server_cfg_path() {
    local data_path
    data_path=$(get_server_data_path)
    echo "${data_path}/cfg"
}

# -----------------------------------------------------------------------------
# Settings file generation
# -----------------------------------------------------------------------------
generate_server_cfg() {
    local cfg_path
    cfg_path=$(get_server_cfg_path)
    local cfg_file="${cfg_path}/server.cfg"

    log_info "Generating server.cfg"

    # Create cfg directory if it doesn't exist
    mkdir -p "${cfg_path}"

    # Generate server.cfg from environment variables
    cat > "${cfg_file}" << EOF
# =============================================================================
# Rust Server Configuration
# Generated by Absolute Rust Server
# =============================================================================

# Server Identity
server.hostname "${SERVER_NAME:-Rust Server}"
server.description "${SERVER_DESCRIPTION:-}"
server.url "${SERVER_URL:-}"
server.headerimage "${SERVER_HEADERIMAGE:-}"
server.tags "${SERVER_TAGS:-}"

# Server Settings
server.maxplayers ${SERVER_MAXPLAYERS:-50}
server.worldsize ${SERVER_WORLDSIZE:-4000}
server.saveinterval ${SERVER_SAVEINTERVAL:-600}
EOF

    # Add RCON settings if enabled
    if is_rcon_enabled; then
        cat >> "${cfg_file}" << EOF

# RCON Settings
rcon.port ${RCON_PORT:-28016}
rcon.password "${RCON_PASSWORD:-}"
rcon.web $(is_rcon_web_enabled && echo "1" || echo "0")
EOF
    fi

    # server.cfg holds the RCON password, keep it private to the server user
    chmod 600 "${cfg_file}" 2>/dev/null || true
    chown rust:rust "${cfg_file}" 2>/dev/null || true
    log_success "server.cfg generated at ${cfg_file}"
}

# -----------------------------------------------------------------------------
# Wait helpers
# -----------------------------------------------------------------------------
wait_for_server_ready() {
    local timeout="${1:-300}"
    local elapsed=0

    log_info "Waiting for server to be ready (timeout: ${timeout}s)"

    while [[ ${elapsed} -lt ${timeout} ]]; do
        # Check if process is running
        if is_server_running; then
            # Check logs for ready message
            if grep -q "Server startup complete" "${LOG_PATH}/rust-server.log" 2>/dev/null; then
                log_success "Server is ready"
                return 0
            fi
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done

    log_warn "Server readiness timeout after ${timeout}s"
    return 1
}

# -----------------------------------------------------------------------------
# Steam SDK
# -----------------------------------------------------------------------------
# Put steamclient.so where the server user can read it.
#
# SteamCMD runs as root and leaves its copy under /root/.steam, and /root is mode
# 700. The server runs as ${SERVER_USER}, so it could not read the library:
# SteamAPI_Init failed on every start, the unhandled NullReferenceException that
# follows tore the server down, and the watchdog restarted it every 35 seconds
# forever. The server had never started successfully (#14).
#
# Called from bootstrap before supervisor starts, and again after any later
# update, because SteamCMD refreshes steamclient.so along with the client.
install_steam_sdk() {
    local bits source dest installed_64=false

    for bits in 64 32; do
        dest="${SERVER_HOME}/.steam/sdk${bits}"

        # In preference order: the copy SteamCMD refreshed when it last ran,
        # then the two places the image itself carries one.
        for source in \
            "${STEAMCMD_HOME}/.steam/sdk${bits}/steamclient.so" \
            "${STEAMCMD_PATH}/linux${bits}/steamclient.so" \
            "${STEAMCMD_HOME}/Steam/steamcmd/linux${bits}/steamclient.so"; do

            [[ -r "${source}" ]] || continue

            if ! mkdir -p "${dest}" 2>/dev/null; then
                log_warn "Could not create ${dest}"
                break
            fi
            if ! cp -f "${source}" "${dest}/steamclient.so" 2>/dev/null; then
                log_warn "Could not copy ${source} to ${dest}"
                break
            fi

            chmod 0644 "${dest}/steamclient.so" 2>/dev/null || true
            [[ "${bits}" == "64" ]] && installed_64=true
            log_info "Installed ${bits}-bit steamclient.so from ${source}"
            break
        done
    done

    # Ownership only matters in the container, where this runs as root.
    chown -R "${SERVER_USER}:${SERVER_GROUP}" "${SERVER_HOME}/.steam" 2>/dev/null || true

    # RustDedicated is 64-bit. Without sdk64 it cannot initialise Steam at all,
    # so say so rather than letting the server crash-loop unexplained.
    if [[ "${installed_64}" != "true" ]]; then
        log_error "No 64-bit steamclient.so found; the server cannot initialise Steam"
        log_error "Looked under ${STEAMCMD_HOME}/.steam, ${STEAMCMD_PATH} and ${STEAMCMD_HOME}/Steam"
        return 1
    fi

    return 0
}
